:3000

root * /srv

route {
	try_files {path} {path}/ /index.html

	# Match the final file, including HTML served for deep app routes.
	@pwa path /sw.js /*.webmanifest /index.html /
	header @pwa Cache-Control "no-cache"
	@manifest path /*.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# Security headers (modern-web-guidance security guide).
	# script-src hash covers the inline theme script in index.html; regenerate
	# it (sha256 of the <script> body, base64) whenever that script changes.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-GOU3vqT3irH3r6cEoyblZBXVnyw51SfFgjIdMkWVXHc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http: blob:; media-src 'self' https: http: data: blob:; connect-src 'self' https: http: wss:; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; frame-src https: http:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"

	file_server
}
